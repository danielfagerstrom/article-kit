#!/bin/sh
# Re-emit blueprint-manifest.json into the wiki after any commit that touches what
# the manifest projects (blueprint labels, Lean decls, scripts/ paths). Keeps the
# wiki's freshness stamp current without a manual step — see blueprint/LINKAGE.md
# § "The cross-repo channel". Activate once with:
#     git config core.hooksPath .githooks
# Best-effort: never fails the commit.

# `-m --first-parent` so merge commits are diffed too (against the previous branch
# tip); plain `diff-tree -r` emits nothing for a merge, which would silently skip
# the re-emit on every merge to main.
git diff-tree -m --first-parent --no-commit-id --name-only -r HEAD \
    | grep -qE '^(blueprint/|Formalization/|scripts/)' || exit 0

WIKI_VAULT="${WIKI_VAULT:-C:/Users/danie/Documents/Notes}"
python scripts/check_linkage.py --emit-manifest "$WIKI_VAULT/blueprint-manifest.json" \
    || echo "post-commit: manifest re-emit failed (run check_linkage.py --emit-manifest by hand)"
exit 0

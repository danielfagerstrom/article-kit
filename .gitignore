# The framework repo builds no documents and holds no Lean package — the LaTeX/Lean
# ignores that used to live here belong in the article repos, and are seeded there by
# `linkage init` writing scaffold/gitignore.article into a new article's .gitignore.

# Python
__pycache__/
*.egg-info/
.venv/
dist/
build/

# tooling scratch (uv run --with ... regenerates this)
uv.lock

# test / lint caches
.pytest_cache/
.ruff_cache/

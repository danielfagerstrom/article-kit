{
  "extraKnownMarketplaces": {
    "article-kit": {
      "source": {
        "source": "github",
        "repo": "danielfagerstrom/article-kit"
      }
    }
  },
  "enabledPlugins": {
    "article-kit@article-kit": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/cloud-setup.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/sync-agents-hook.sh\" || true"
          }
        ]
      }
    ]
  }
}
